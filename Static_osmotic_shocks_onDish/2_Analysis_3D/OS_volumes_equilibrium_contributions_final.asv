%% Fonctions
function d = editDistance(str1, str2)
    % Compute Levenshtein distance between two strings
    m = length(str1);
    n = length(str2);
    D = zeros(m+1, n+1);

    for i = 0:m, D(i+1,1) = i; end
    for j = 0:n, D(1,j+1) = j; end

    for i = 2:m+1
        for j = 2:n+1
            cost = (str1(i-1) ~= str2(j-1));
            D(i,j) = min([D(i-1,j) + 1, D(i,j-1) + 1, D(i-1,j-1) + cost]);
        end
    end
    d = D(m+1, n+1);
end
